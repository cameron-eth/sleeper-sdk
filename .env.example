# Sleeper SDK secrets — copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed.
#
# SLEEPER_TOKEN is the session token that authorizes writes (trades/drafts).
# Capture it from the Sleeper web app and paste it after the `=` (no quotes
# needed). Only `send-trade` and other write ops use it; all read-only
# commands (find-trades, league-values, etc.) work without it.
SLEEPER_TOKEN=
